---
import Terminal from './Terminal.astro';
---

<section class="hero" id="inicio">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge-wrap">
          <span class="badge badge-status">
            <span class="pulse-dot"></span>
            Disponível para novos projetos & contratos
          </span>
        </div>
        <h1 class="hero-title">
          Engenharia Web sob Medida, <span class="gradient-text">Alta Performance</span> & SEO Técnico.
        </h1>
        <p class="hero-subtitle">
          Olá! Sou <strong>Rodrigo Rego de Lima</strong>, desenvolvedor web especializado no ecossistema WordPress avançado (plugins customizados e arquitetura desacoplada), Next.js, PHP e JavaScript. Focado em resolver regras de negócio complexas, otimização extrema de Core Web Vitals e automações escaláveis.
        </p>
        <div class="hero-actions">
          <a href="https://wa.me/5581981656577" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            Iniciar Conversa
          </a>
          <a href="#projetos" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            Ver Projetos
          </a>
          <a href="/curriculo-rodrigo-rego-de-lima.pdf" download="Curriculo_Rodrigo_Rego_de_Lima.pdf" class="btn btn-outline" title="Baixar currículo oficial em PDF">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Baixar Currículo (PDF)
          </a>
        </div>

        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-number">+3 <span>anos</span></div>
            <div class="stat-label">Experiência Web</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">+20 <span>projetos</span></div>
            <div class="stat-label">Sites & Portais</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">100<span>%</span></div>
            <div class="stat-label">Foco Core Web Vitals</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">100<span>%</span></div>
            <div class="stat-label">Código Modular</div>
          </div>
        </div>
      </div>

      <div class="hero-terminal">
        <Terminal />
      </div>
    </div>
  </div>
</section>
