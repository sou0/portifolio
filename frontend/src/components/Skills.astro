---
---
<section id="habilidades" style="background: rgba(255, 255, 255, 0.015);">
  <div class="container">
    <div class="section-header">
      <span class="badge">Stack Tecnológica</span>
      <h2 class="section-title">Habilidades Técnicas</h2>
      <p class="section-desc">Ferramentas, linguagens e ecossistemas com os quais desenvolvo diariamente soluções para produção.</p>
    </div>

    <div class="skills-grid">
      <!-- Frontend -->
      <div class="skill-category-card">
        <div class="skill-cat-header">
          <div class="skill-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          </div>
          <div>
            <h3>Frontend & UI</h3>
            <p style="font-size: 0.8rem;">Interfaces Velozes</p>
          </div>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">Next.js</span>
          <span class="skill-tag">React.js</span>
          <span class="skill-tag">Astro</span>
          <span class="skill-tag">JavaScript (ES6+)</span>
          <span class="skill-tag">Vanilla JS</span>
          <span class="skill-tag">HTML5 / CSS3</span>
          <span class="skill-tag">Elementor Pro</span>
          <span class="skill-tag">Responsividade Total</span>
        </div>
      </div>

      <!-- Backend & CMS -->
      <div class="skill-category-card">
        <div class="skill-cat-header">
          <div class="skill-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
          </div>
          <div>
            <h3>Backend & CMS</h3>
            <p style="font-size: 0.8rem;">Lógica & Arquitetura</p>
          </div>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">PHP</span>
          <span class="skill-tag">WordPress Avançado</span>
          <span class="skill-tag">Plugins Customizados</span>
          <span class="skill-tag">Python</span>
          <span class="skill-tag">Node.js</span>
          <span class="skill-tag">REST APIs</span>
          <span class="skill-tag">ACF Pro</span>
        </div>
      </div>

      <!-- Databases -->
      <div class="skill-category-card">
        <div class="skill-cat-header">
          <div class="skill-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
          </div>
          <div>
            <h3>Bancos de Dados</h3>
            <p style="font-size: 0.8rem;">Armazenamento & Queries</p>
          </div>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">MySQL</span>
          <span class="skill-tag">PostgreSQL</span>
          <span class="skill-tag">MongoDB</span>
          <span class="skill-tag">Migração de Dados</span>
          <span class="skill-tag">Lotes Seguros / Rollback</span>
        </div>
      </div>

      <!-- SEO Técnico & Performance -->
      <div class="skill-category-card">
        <div class="skill-cat-header">
          <div class="skill-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <div>
            <h3>SEO & Performance</h3>
            <p style="font-size: 0.8rem;">Indexação & Velocidade</p>
          </div>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">Core Web Vitals</span>
          <span class="skill-tag">Dynamic NoIndex</span>
          <span class="skill-tag">Open Graph & Schema</span>
          <span class="skill-tag">Bypass de Cache</span>
          <span class="skill-tag">WP Rocket / Cloudflare</span>
          <span class="skill-tag">Sitemaps Dinâmicos</span>
        </div>
      </div>

      <!-- Automação & DevOps -->
      <div class="skill-category-card">
        <div class="skill-cat-header">
          <div class="skill-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </div>
          <div>
            <h3>Automação & Infra</h3>
            <p style="font-size: 0.8rem;">DevOps & Pipelines</p>
          </div>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">n8n</span>
          <span class="skill-tag">Firebase Serverless</span>
          <span class="skill-tag">Git / GitHub</span>
          <span class="skill-tag">Gestão de Servidores</span>
          <span class="skill-tag">Staging & Homologação</span>
          <span class="skill-tag">Webhooks</span>
        </div>
      </div>

      <!-- Idiomas & Formação -->
      <div class="skill-category-card">
        <div class="skill-cat-header">
          <div class="skill-icon-wrap">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          </div>
          <div>
            <h3>Formação & Idiomas</h3>
            <p style="font-size: 0.8rem;">Comunicação & Base</p>
          </div>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">Graduação ADS (UNINASSAU)</span>
          <span class="skill-tag">Inglês B1 (Intermediário)</span>
          <span class="skill-tag">Português (Nativo)</span>
          <span class="skill-tag">Metodologias Ágeis</span>
        </div>
      </div>
    </div>
  </div>
</section>
