---
---
<section id="contato" style="background: rgba(255, 255, 255, 0.015);">
  <div class="container">
    <div class="section-header">
      <span class="badge">Vamos Conversar</span>
      <h2 class="section-title">Entre em Contato</h2>
      <p class="section-desc">Precisa de um plugin sob medida, uma landing page de alta conversão ou otimização de performance técnica? Fale comigo agora mesmo.</p>
    </div>

    <div class="contact-grid">
      <!-- Contact Info Cards -->
      <div class="contact-info-card">
        <!-- WhatsApp Card -->
        <a href="https://wa.me/5581981656577" target="_blank" rel="noopener noreferrer" class="contact-method">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </div>
          <div class="contact-details">
            <span>WhatsApp Direto</span>
            <strong>(81) 98165-6577</strong>
          </div>
        </a>

        <!-- Email Card with Copy Feature -->
        <div class="contact-method" style="cursor: pointer;" id="copy-email-btn">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div class="contact-details" style="flex-grow: 1;">
            <span>E-mail (Clique para Copiar)</span>
            <strong>rodrigoregodelima01@gmail.com</strong>
          </div>
          <button class="btn btn-outline btn-sm" type="button" aria-label="Copiar E-mail">Copiar</button>
        </div>

        <!-- GitHub Card -->
        <a href="https://github.com/sou0" target="_blank" rel="noopener noreferrer" class="contact-method">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </div>
          <div class="contact-details">
            <span>GitHub</span>
            <strong>github.com/sou0</strong>
          </div>
        </a>

        <!-- Backend Status Badge -->
        <div class="contact-method" id="backend-status-card">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
          </div>
          <div class="contact-details">
            <span>Backend NestJS</span>
            <strong id="backend-status-text" style="color: #10b981;">Online (localhost:3000/api)</strong>
          </div>
        </div>
      </div>

      <!-- Direct Contact Form -->
      <div class="contact-form">
        <h3 style="font-size: 1.4rem; margin-bottom: 8px;">Enviar Mensagem Direta</h3>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 24px;">
          Preencha os campos abaixo. A mensagem será validada pela API NestJS e encaminhada instantaneamente.
        </p>
        <form id="contact-form">
          <div class="form-group">
            <label for="contact-name">Seu Nome</label>
            <input type="text" id="contact-name" class="form-control" placeholder="Ex: Maria Silva" required minlength="2">
          </div>
          <div class="form-group">
            <label for="contact-email">Seu E-mail</label>
            <input type="email" id="contact-email" class="form-control" placeholder="Ex: maria@empresa.com" required>
          </div>
          <div class="form-group">
            <label for="contact-subject">Assunto</label>
            <input type="text" id="contact-subject" class="form-control" placeholder="Ex: Criação de Plugin / Proposta de Projeto" required minlength="3">
          </div>
          <div class="form-group">
            <label for="contact-message">Mensagem</label>
            <textarea id="contact-message" class="form-control" placeholder="Conte brevemente sobre o projeto, requisitos ou prazo..." required minlength="5"></textarea>
          </div>
          <button type="submit" id="submit-btn" class="btn btn-primary" style="width: 100%;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            <span id="btn-text">Enviar via NestJS API</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { PortfolioApiService } from '../services/api';
  import type { ContactFormData } from '../types/portfolio';

  // Copy Email Button Listener
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      (window as any).copyToClipboard('rodrigoregodelima01@gmail.com', 'E-mail');
    });
  }

  // Check Backend Health
  PortfolioApiService.checkHealth().then(res => {
    const statusText = document.getElementById('backend-status-text');
    if (statusText) {
      if (res.status === 'ok') {
        statusText.textContent = 'NestJS API Conectada (port 3000)';
        statusText.style.color = '#10b981';
      } else {
        statusText.textContent = 'Modo Direto / Offline';
        statusText.style.color = '#f59e0b';
      }
    }
  });

  // Contact Form Handling with NestJS API
  const contactForm = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');

  if (contactForm) {
    contactForm.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
      const subject = (document.getElementById('contact-subject') as HTMLInputElement).value.trim();
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value.trim();

      const payload: ContactFormData = { name, email, subject, message };

      if (submitBtn && btnText) {
        submitBtn.disabled = true;
        btnText.textContent = 'Validando no NestJS...';
      }

      try {
        const result = await PortfolioApiService.submitContact(payload);

        if (result.success) {
          (window as any).showToast('Mensagem validada pelo NestJS!');
          if (result.data?.whatsappUrl) {
            setTimeout(() => {
              window.open(result.data?.whatsappUrl, '_blank');
            }, 600);
          }
          contactForm.reset();
        } else {
          // Fallback direct WhatsApp dispatch if backend offline
          (window as any).showToast(result.message || 'Encaminhando via WhatsApp...');
          const fallbackText = `Olá Rodrigo! Meu nome é ${name} (${email}).\n*Assunto:* ${subject}\n*Mensagem:* ${message}`;
          const fallbackUrl = `https://wa.me/5581981656577?text=${encodeURIComponent(fallbackText)}`;
          setTimeout(() => {
            window.open(fallbackUrl, '_blank');
          }, 600);
        }
      } catch (err: any) {
        (window as any).showToast('Erro ao processar mensagem.');
      } finally {
        if (submitBtn && btnText) {
          submitBtn.disabled = false;
          btnText.textContent = 'Enviar via NestJS API';
        }
      }
    });
  }
</script>
