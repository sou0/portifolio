---
---
<section id="curriculo" style="background: rgba(255, 255, 255, 0.015);">
  <div class="container">
    <div class="section-header">
      <span class="badge">Documento Oficial</span>
      <h2 class="section-title">Currículo Profissional</h2>
      <p class="section-desc">Visualize o documento original em PDF com todas as qualificações, histórico e projetos, ou faça o download para avaliação.</p>
    </div>

    <!-- Preview Container Box -->
    <div style="max-width: 960px; margin: 0 auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);">
      
      <!-- Toolbar Header -->
      <div style="padding: 16px 24px; background: rgba(255, 255, 255, 0.03); border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="display: flex; gap: 8px;">
            <span style="width: 12px; height: 12px; border-radius: 50%; background: #ef4444; display: inline-block;"></span>
            <span style="width: 12px; height: 12px; border-radius: 50%; background: #f59e0b; display: inline-block;"></span>
            <span style="width: 12px; height: 12px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <span style="font-size: 0.9rem; font-weight: 600; font-family: var(--font-mono); color: var(--text-primary);">Curriculo_Rodrigo_Rego_de_Lima.pdf</span>
            <span class="badge" style="font-size: 0.7rem; padding: 2px 8px;">106 KB</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; align-items: center; gap: 10px;">
          <a href="/curriculo-rodrigo-rego-de-lima.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" title="Abrir em tela cheia">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            Nova Aba
          </a>
          <a href="/curriculo-rodrigo-rego-de-lima.pdf" download="Curriculo_Rodrigo_Rego_de_Lima.pdf" class="btn btn-primary btn-sm" title="Baixar arquivo PDF">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Baixar PDF
          </a>
        </div>
      </div>

      <!-- PDF Frame Viewport -->
      <div style="position: relative; width: 100%; height: 780px; background: #525659;">
        <iframe 
          id="pdf-frame"
          src="/curriculo-rodrigo-rego-de-lima.pdf#toolbar=1&navpanes=0&scrollbar=1" 
          width="100%" 
          height="100%" 
          style="border: none; display: block;" 
          title="Preview do Currículo de Rodrigo Rego de Lima"
        >
          <div style="padding: 40px; text-align: center; color: #fff;">
            <p style="margin-bottom: 16px;">Seu navegador não suporta visualização direta de PDF.</p>
            <a href="/curriculo-rodrigo-rego-de-lima.pdf" download="Curriculo_Rodrigo_Rego_de_Lima.pdf" class="btn btn-primary">
              Clique aqui para baixar o currículo em PDF
            </a>
          </div>
        </iframe>
      </div>

      <!-- Footer Info Bar -->
      <div style="padding: 12px 24px; background: rgba(255, 255, 255, 0.02); border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem; color: var(--text-muted); flex-wrap: wrap; gap: 8px;">
        <span>Documento oficial atualizado • Formato padrão A4</span>
        <div style="display: flex; gap: 16px;">
          <span>Paulista, PE</span>
          <span>•</span>
          <span>(81) 98165-6577</span>
        </div>
      </div>
    </div>
  </div>
</section>
